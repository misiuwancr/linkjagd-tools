# Lokale SQLite-Datei. Auf Vercel nicht setzen, dort gelten die Turso-Variablen.
DATABASE_URL=file:./data/linkjagd.db

# Produktiv (Vercel). Beide zusammen, sonst startet die App dort nicht.
# TURSO_DATABASE_URL=libsql://dein-name-deine-org.turso.io
# TURSO_AUTH_TOKEN=

# Mindestens 16 Zeichen, kein Platzhalter. Erzeugen mit: openssl rand -hex 32
JWT_SECRET=ersetze-mich-mit-einem-langen-geheimnis

# Erster Admin, nur wenn noch kein Benutzer existiert. Passwort mindestens 12 Zeichen.
# Die Übertragung aus der lokalen Datei kopiert den vorhandenen Admin mit Hash, ohne ihn auszugeben.
ADMIN_EMAIL=admin@linkjagd.local
ADMIN_PASSWORD=ersetze-mich-mit-mindestens-12-zeichen

# Öffentliche Basis-URL für Sitemap, Canonical und Open Graph. Domain später eintragen.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4327

# Optional. Solange leer, antwortet POST /api/import mit 503.
IMPORT_API_TOKEN=

# Indexierung. Auf Vercel-Produktion leer lassen, dann bleibt das heutige Verhalten (indexierbar).
# INDEXING_ENABLED=false schaltet die Produktion auf noindex. Vorschau und lokal sind immer noindex.
# INDEXING_ENABLED=

# Newsletter. Ohne NEWSLETTER_PROVIDER speichert das Formular keine Adresse.
# NEWSLETTER_PROVIDER=brevo
# NEWSLETTER_FROM=redaktion@example.com
# BREVO_API_KEY=
# BREVO_LIST_ID=
# BREVO_DOI_TEMPLATE_ID=
# Alternativ: NEWSLETTER_PROVIDER=resend und RESEND_API_KEY=

# Vorschau-Deployments. Heute zeigen dieselben Turso-Variablen auf die Produktionsdatenbank.
# Für Vorschau eine eigene kostenlose Turso-Datenbank anlegen und nur dort TURSO_DATABASE_URL und TURSO_AUTH_TOKEN der Preview setzen.
