# Lokale SQLite-Datei über libSQL (kein Turso-Konto nötig).
DATABASE_URL=file:./data/linkjagd.db

# Mindestens 16 Zeichen. Erzeugen mit: openssl rand -hex 32
JWT_SECRET=ersetze-mich-mit-einem-langen-geheimnis

# Erster Admin-Account, wird nur angelegt wenn noch kein Benutzer existiert.
ADMIN_EMAIL=admin@linkjagd.local
ADMIN_PASSWORD=ersetze-mich-mit-mindestens-12-zeichen

# Öffentliche Basis-URL (Canonical, Sitemap).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4327

# Optional. Solange leer, antwortet POST /api/import mit 503.
IMPORT_API_TOKEN=

# Optional. Solange leer, verschickt das Newsletter-Formular nichts und speichert keine Adresse.
# NEWSLETTER_PROVIDER=
